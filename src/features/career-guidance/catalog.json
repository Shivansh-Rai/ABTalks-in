{
  "version": 1,
  "items": [
    {
      "id": "checkin-dsa-se",
      "kind": "checkin",
      "cadence": "daily",
      "title": "Did you solve a DSA question today?",
      "body": "Even one question keeps you moving.",
      "ctaLabel": "Practise",
      "href": "/mock-interviews",
      "when": { "challengeDomains": ["SE"] }
    },
    {
      "id": "checkin-dsa-role",
      "kind": "checkin",
      "cadence": "daily",
      "title": "Did you solve a DSA question today?",
      "body": "Even one question keeps you moving.",
      "ctaLabel": "Practise",
      "href": "/mock-interviews",
      "when": { "roleIncludes": ["software", "backend", "frontend", "sde"] }
    },
    {
      "id": "checkin-cohort-today",
      "kind": "checkin",
      "cadence": "daily",
      "title": "Did you open today's AI Cohort lesson?",
      "body": "Keep your learning streak going.",
      "ctaLabel": "Open",
      "href": "/program/ai-cohort/dashboard",
      "when": { "aiCohortActive": true }
    },
    {
      "id": "checkin-add-skill",
      "kind": "checkin",
      "cadence": "daily",
      "title": "Add a skill on your profile",
      "body": "Help recruiters understand what you work with.",
      "ctaLabel": "Add skills",
      "href": "/profile",
      "when": { "skillsEmpty": true }
    },
    {
      "id": "checkin-practise",
      "kind": "checkin",
      "cadence": "daily",
      "title": "Did you practise for 30 minutes today?",
      "body": "A little practice today can make tomorrow easier.",
      "ctaLabel": "Open mocks",
      "href": "/mock-interviews",
      "when": { "always": true }
    },
    {
      "id": "quote-seneca-luck",
      "kind": "quote",
      "cadence": "weekly",
      "title": "Luck is what happens when preparation meets opportunity.",
      "body": "Seneca",
      "when": { "always": true }
    },
    {
      "id": "quote-confucius-slowly",
      "kind": "quote",
      "cadence": "weekly",
      "title": "It does not matter how slowly you go as long as you do not stop.",
      "body": "Confucius",
      "when": { "always": true }
    },
    {
      "id": "quote-plato-beginning",
      "kind": "quote",
      "cadence": "weekly",
      "title": "The beginning is the most important part of the work.",
      "body": "Plato",
      "when": { "always": true }
    },
    {
      "id": "quote-curie-progress",
      "kind": "quote",
      "cadence": "once",
      "title": "I was taught that the way of progress was neither swift nor easy.",
      "body": "Marie Curie",
      "when": { "always": true }
    },
    {
      "id": "quote-mandela-education",
      "kind": "quote",
      "cadence": "once",
      "title": "Education is the most powerful weapon which you can use to change the world.",
      "body": "Nelson Mandela",
      "when": { "always": true }
    }
  ]
}